{
  "name": "arve-makseks",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "setup": "prisma generate && prisma migrate deploy",
    "postinstall": "prisma generate",
    "desktop:stage": "node desktop/stage.mjs",
    "desktop:pack": "npm run build && npm run desktop:stage && electron-builder --config desktop/builder.cjs --win --x64 --publish never && node desktop/audit.mjs && node desktop/fast-portable.mjs",
    "desktop:smoke": "node desktop/smoke.mjs",
    "desktop:key-smoke": "node desktop/key-smoke.mjs",
    "desktop:language-smoke": "node desktop/language-smoke.mjs",
    "desktop:local-smoke": "node desktop/local-smoke.mjs",
    "desktop:portable-smoke": "node --import tsx desktop/portable-smoke.mjs",
    "desktop:audit": "node desktop/audit.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@google/genai": "2.27.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tabler/icons-react": "^3.0.0",
    "dotenv": "^17.0.0",
    "fast-xml-parser": "^5.0.0",
    "ibantools": "^4.5.0",
    "libxml2-wasm": "0.7.2",
    "next": "16.3.8",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "5.4.296",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xmlbuilder2": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@electron/get": { "global-agent": "4.1.3" },
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "prisma": {
      "mysql2": "3.24.6"
    }
  }
}
